+
+describe('E2EE Context: frame counter and replay protection', () => {
+    const key = new Uint8Array(32).fill(7);
+    let sender;
+    let receiver;
+
+    /**
+     * Encrypts n frames made by makeFrame and returns them.
+     */
+    async function encrypt(n, makeFrame = makeAudioFrame) {
+        const out = [];
+        const controller = { enqueue: f => out.push(f) };
+
+        for (let i = 0; i < n; i++) {
+            await sender.encodeFunction(makeFrame(), controller);
+        }
+
+        return out;
+    }
+
+    // A fresh copy, as decodeFunction replaces the frame's data with the plaintext.
+    const copy = f => ({ ...f, data: f.data.slice(0) });
+
+    // Decodes copies of the given frames in order and returns how many the receiver let through.
+    async function decode(frames) {
+        let n = 0;
+        const controller = { enqueue: () => n++ };
+
+        for (const f of frames) {
+            await receiver.decodeFunction(copy(f), controller);
+        }
+
+        return n;
+    }
+
+    // The 32-bit frame counter: the last 4 bytes of the IV, which sits before the 2-byte trailer.
+    const counterOf = f => new DataView(f.data).getUint32(f.data.byteLength - 2 - 12 + 8);
+
+    beforeEach(async () => {
+        sender = new Context('sender');
+        sender.setEnabled(true);
+        await sender.setKey(key, 0);
+        receiver = new Context('receiver');
+        receiver.setEnabled(true);
+        await receiver.setKey(key, 0);
+    });
+
+    it('counts frames with the full 32 bits, one step per frame', async () => {
+        const frames = await encrypt(5);
+
+        for (let i = 1; i < frames.length; i++) {
+            expect(counterOf(frames[i])).toEqual((counterOf(frames[i - 1]) + 1) >>> 0);
+        }
+    });
+
+    it('starts each stream\'s counter at a random 32-bit value', async () => {
+        const starts = [];
+
+        for (let i = 0; i < 20; i++) {
+            sender = new Context('sender');
+            sender.setEnabled(true);
+            await sender.setKey(key, 0);
+            starts.push(counterOf((await encrypt(1))[0]));
+        }
+
+        // The old counter stayed below 0xFFFF; 20 random 32-bit starts all below it has odds 2^-320.
+        expect(starts.some(c => c >= 0xFFFF)).toBe(true);
+        expect(new Set(starts).size).toEqual(starts.length);
+    });
+
+    it('keeps counting across a key change', async () => {
+        const [ before ] = await encrypt(1);
+
+        await sender.setKey(new Uint8Array(32).fill(9), 1);
+        const [ after ] = await encrypt(1);
+
+        expect(counterOf(after)).toEqual((counterOf(before) + 1) >>> 0);
+    });
+
+    it('decrypts a frame once and drops an exact replay', async () => {
+        const [ frame ] = await encrypt(1);
+
+        expect(await decode([ frame ])).toEqual(1);
+        expect(await decode([ frame ])).toEqual(0);
+    });
+
+    it('drops a frame replayed later in the stream', async () => {
+        const frames = await encrypt(10);
+
+        expect(await decode(frames)).toEqual(10);
+        expect(await decode([ frames[3] ])).toEqual(0);
+        expect(await decode([ frames[9] ])).toEqual(0);
+    });
+
+    it('accepts frames reordered within the window', async () => {
+        const f = await encrypt(5);
+
+        expect(await decode([ f[0], f[2], f[1], f[4], f[3] ])).toEqual(5);
+    });
+
+    it('drops an unseen frame older than the window, accepts one inside it', async () => {
+        const f = await encrypt(1100);
+
+        expect(await decode([ f[0], f[1099] ])).toEqual(2);
+        expect(await decode([ f[1] ])).toEqual(0); // 1098 frames behind: stale
+        expect(await decode([ f[100] ])).toEqual(1); // 999 frames behind, never seen
+        expect(await decode([ f[100] ])).toEqual(0); // and only once
+    });
+
+    it('keeps a separate window for each stream', async () => {
+        const audio = await encrypt(3, makeAudioFrame);
+        const video = await encrypt(3, makeVideoFrame);
+
+        expect(await decode([ audio[0], video[0], audio[1], video[1], audio[2], video[2] ])).toEqual(6);
+        expect(await decode([ audio[1], video[2] ])).toEqual(0);
+    });
+
+    it('rejects a replay whose counter was changed, because the IV is authenticated', async () => {
+        const [ frame ] = await encrypt(1);
+
+        expect(await decode([ frame ])).toEqual(1);
+
+        const forged = copy(frame);
+        const view = new DataView(forged.data);
+        const at = forged.data.byteLength - 2 - 12 + 8;
+
+        view.setUint32(at, (view.getUint32(at) + 1) >>> 0);
+        expect(await decode([ forged ])).toEqual(0);
+    });
+
+    it('follows a sender from before this change across its counter wrap at 0xFFFF', async () => {
+        sender._sendCounts.set(123, 0xFFFD);
+        const old = await encrypt(2); // counters 0xFFFD, 0xFFFE
+
+        sender._sendCounts.set(123, 0); // the old sender wraps to 0
+        const wrapped = await encrypt(2); // counters 0, 1
+
+        expect(await decode([ ...old, ...wrapped ])).toEqual(4);
+        expect(await decode([ old[1] ])).toEqual(0);
+    });
+
+    it('follows a 32-bit counter across its wrap at 2^32', async () => {
+        sender._sendCounts.set(123, 0xFFFFFFFE);
+        const f = await encrypt(4); // counters 0xFFFFFFFE, 0xFFFFFFFF, 0, 1
+
+        expect(counterOf(f[2])).toEqual(0);
+        expect(await decode(f)).toEqual(4);
+        expect(await decode([ f[1] ])).toEqual(0);
+    });
+
+    it('passes an empty frame through but drops a short frame that doesn\'t decrypt', async () => {
+        const out = [];
+        const controller = { enqueue: f => out.push(f) };
+        const frame = bytes => ({
+            data: new Uint8Array(bytes).buffer,
+            type: 'key',
+            getMetadata: () => ({ synchronizationSource: 321 })
+        });
+
+        await receiver.decodeFunction(frame([]), controller);
+        await receiver.decodeFunction(frame([ 1, 2, 3, 4, 5, 6, 7, 8, 9 ]), controller);
+        expect(out.length).toEqual(1);
+        expect(out[0].data.byteLength).toEqual(0);
+    });
+
+    it('treats a stream that started below 0xFFFF and passes it as a 32-bit sender', async () => {
+        sender._sendCounts.set(123, 0xFFFD);
+        const f = await encrypt(4); // counters 0xFFFD, 0xFFFE, 0xFFFF, 0x10000
+
+        expect(await decode(f)).toEqual(4);
+        expect(await decode([ f[0] ])).toEqual(0);
+    });
+});
