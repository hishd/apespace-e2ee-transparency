diff --git a/modules/e2ee/vault/VaultConference.js b/modules/e2ee/vault/VaultConference.js
new file mode 100644
index 00000000..24a524dd
--- /dev/null
+++ b/modules/e2ee/vault/VaultConference.js
@@ -0,0 +1,208 @@
+import { JitsiConferenceEvents } from '../../../JitsiConferenceEvents';
+import EventEmitter from '../../util/EventEmitter';
+
+/**
+ * A participant as the key vault knows it: what the page reports of the real
+ * JitsiParticipant (ID, hidden, features and the E2EE presence properties).
+ */
+class VaultParticipant {
+    /**
+     * @param {Object} description - { id, hidden, features, properties }.
+     */
+    constructor({ id, hidden, features = [], properties = {} }) {
+        this._id = id;
+        this._hidden = Boolean(hidden);
+        this._features = new Set(features);
+        this._properties = new Map(Object.entries(properties));
+    }
+
+    /**
+     * @returns {string}
+     */
+    getId() {
+        return this._id;
+    }
+
+    /**
+     * @returns {boolean}
+     */
+    isHidden() {
+        return this._hidden;
+    }
+
+    /**
+     * @param {string} feature - The feature.
+     * @returns {boolean}
+     */
+    hasFeature(feature) {
+        return this._features.has(feature);
+    }
+
+    /**
+     * @returns {Promise<Set<string>>}
+     */
+    getFeatures() {
+        return Promise.resolve(this._features);
+    }
+
+    /**
+     * @param {string} name - The property.
+     * @returns {*}
+     */
+    getProperty(name) {
+        return this._properties.get(name);
+    }
+}
+
+/**
+ * Stands in for JitsiConference inside the key vault, so the unchanged Olm
+ * adapter and managed key handler run there. It knows only what the page
+ * reports (participants, their E2EE properties, Olm messages), and everything
+ * the key code sends out goes back to the page as data: Olm messages (already
+ * encrypted), our public identity keys, and E2EE events. Media keys never go
+ * through it: they go to the encryption worker over their own port.
+ */
+export default class VaultConference {
+    /**
+     * @param {Function} send - Sends a message to the page.
+     */
+    constructor(send) {
+        this._send = send;
+        this._participants = new Map();
+        this._myId = null;
+        this._e2eeEnabled = false;
+        this.eventEmitter = new EventEmitter();
+
+        // KeyHandler subscribes to media events; the vault has no media.
+        this.rtc = { on: () => undefined };
+    }
+
+    /**
+     * @param {string} event - The event.
+     * @param {Function} listener - The listener.
+     * @returns {void}
+     */
+    on(event, listener) {
+        this.eventEmitter.on(event, listener);
+    }
+
+    /**
+     * @returns {string|null}
+     */
+    myUserId() {
+        return this._myId;
+    }
+
+    /**
+     * @returns {Array<VaultParticipant>}
+     */
+    getParticipants() {
+        return [ ...this._participants.values() ];
+    }
+
+    /**
+     * @param {string} id - The participant ID.
+     * @returns {VaultParticipant|undefined}
+     */
+    getParticipantById(id) {
+        return this._participants.get(id);
+    }
+
+    /**
+     * @returns {boolean}
+     */
+    isE2EEEnabled() {
+        return this._e2eeEnabled;
+    }
+
+    /**
+     * Sends an Olm message to a participant, through the page.
+     *
+     * @param {Object} payload - The message.
+     * @param {string} to - The participant ID.
+     * @returns {void}
+     */
+    sendMessage(payload, to) {
+        this._send({
+            payload,
+            to,
+            type: 'send'
+        });
+    }
+
+    /**
+     * Publishes one of our presence properties, through the page.
+     *
+     * @param {string} name - The property.
+     * @param {*} value - The value.
+     * @returns {void}
+     */
+    setLocalParticipantProperty(name, value) {
+        this._send({
+            name,
+            type: 'set-property',
+            value
+        });
+    }
+
+    /**
+     * Applies a message from the page.
+     *
+     * @param {Object} msg - The message.
+     * @returns {void}
+     */
+    onPageMessage(msg) {
+        switch (msg.type) {
+        case 'conference-joined':
+            this._myId = msg.myId;
+            for (const description of msg.participants ?? []) {
+                this._participants.has(description.id)
+                    || this._participants.set(description.id, new VaultParticipant(description));
+            }
+            this.eventEmitter.emit(JitsiConferenceEvents.CONFERENCE_JOINED);
+            break;
+        case 'conference-left':
+            this.eventEmitter.emit(JitsiConferenceEvents.CONFERENCE_LEFT);
+            break;
+        case 'participant-joined': {
+            const participant = new VaultParticipant(msg.participant);
+
+            this._participants.set(participant.getId(), participant);
+            this.eventEmitter.emit(JitsiConferenceEvents.USER_JOINED, participant.getId(), participant);
+            break;
+        }
+        case 'participant-features': {
+            const participant = this._participants.get(msg.id);
+
+            participant && (participant._features = new Set(msg.features));
+            break;
+        }
+        case 'participant-left': {
+            const participant = this._participants.get(msg.id);
+
+            if (participant) {
+                this.eventEmitter.emit(JitsiConferenceEvents.USER_LEFT, msg.id, participant);
+                this._participants.delete(msg.id);
+            }
+            break;
+        }
+        case 'property-changed': {
+            const participant = this._participants.get(msg.id);
+
+            if (participant) {
+                participant._properties.set(msg.name, msg.newValue);
+                this.eventEmitter.emit(JitsiConferenceEvents.PARTICIPANT_PROPERTY_CHANGED,
+                    participant, msg.name, msg.oldValue, msg.newValue);
+            }
+            break;
+        }
+        case 'endpoint-message': {
+            const participant = this._participants.get(msg.from);
+
+            participant && this.eventEmitter.emit(JitsiConferenceEvents.ENDPOINT_MESSAGE_RECEIVED,
+                participant, msg.payload);
+            break;
+        }
+        }
+    }
+}
diff --git a/modules/e2ee/vault/index.js b/modules/e2ee/vault/index.js
new file mode 100644
index 00000000..2e7846bf
--- /dev/null
+++ b/modules/e2ee/vault/index.js
@@ -0,0 +1,142 @@
+/* global Olm */
+
+// The E2EE key vault: runs in a sandboxed frame (its own, opaque origin), so the
+// page that embeds it can't reach anything in it.
+//
+// It holds everything that knows a key: the Olm account and sessions, our media
+// key and its ratchets, emoji (SAS) verification and the group safety number
+// (the unchanged OlmAdapter and ManagedKeyHandler, running on VaultConference).
+// The page relays Olm messages, which are already encrypted, and receives
+// public identity keys and E2EE events. Media keys go only to the page's
+// encryption worker, over a port the page hands over without keeping.
+//
+// Messages from the page, on the RPC port:
+//   conference-joined { myId, participants }, conference-left,
+//   participant-joined { participant }, participant-left { id },
+//   participant-features { id, features }, property-changed { id, name, oldValue, newValue },
+//   endpoint-message { from, payload }, set-enabled { requestId, enabled },
+//   start-verification { id }, mark-verified { id, verified },
+//   start-group-verification, report-group-verification { roundId, matches }
+// Messages to the page:
+//   ready, send { to, payload }, set-property { name, value },
+//   event { name, args }, done { requestId }
+
+// Olm's WebAssembly, from @matrix-org/olm, built into this script (a data: URL).
+// The vault fetches nothing: in a sandboxed frame (opaque origin) WebKit refuses
+// a fetch of olm.wasm under connect-src 'self', so the vault's policy allows no
+// connections at all, and Olm gets its code from here.
+import olmWasm from '@matrix-org/olm/olm.wasm';
+
+import { JitsiConferenceEvents } from '../../../JitsiConferenceEvents';
+import { ManagedKeyHandler } from '../ManagedKeyHandler';
+
+import VaultConference from './VaultConference';
+
+/**
+ * Makes Olm.init use the built-in WebAssembly instead of fetching olm.wasm.
+ *
+ * @returns {void}
+ */
+function useBuiltInOlmWasm() {
+    const binary = atob(olmWasm.slice(olmWasm.indexOf(',') + 1));
+    const wasmBinary = Uint8Array.from(binary, c => c.charCodeAt(0));
+    const init = Olm.init.bind(Olm);
+
+    Olm.init = (options = {}) => init({ ...options,
+        wasmBinary });
+}
+
+/**
+ * The conference events the key code emits that the page re-emits.
+ */
+const FORWARDED_EVENTS = [
+    JitsiConferenceEvents.E2EE_GROUP_VERIFICATION_FAILED,
+    JitsiConferenceEvents.E2EE_GROUP_VERIFICATION_OUTDATED,
+    JitsiConferenceEvents.E2EE_GROUP_VERIFICATION_READY,
+    JitsiConferenceEvents.E2EE_GROUP_VERIFICATION_REPORTED,
+    JitsiConferenceEvents.E2EE_KEY_RECIPIENTS_CHANGED,
+    JitsiConferenceEvents.E2EE_VERIFICATION_AVAILABLE,
+    JitsiConferenceEvents.E2EE_VERIFICATION_COMPLETED,
+    JitsiConferenceEvents.E2EE_VERIFICATION_READY
+];
+
+/**
+ * Starts the vault once the page has handed over its two ports.
+ *
+ * @param {MessagePort} rpc - Messages with the page.
+ * @param {MessagePort} keyPort - Media keys to the encryption worker.
+ * @returns {void}
+ */
+function start(rpc, keyPort) {
+    const send = msg => rpc.postMessage(msg);
+    const conference = new VaultConference(send);
+
+    // Where ManagedKeyHandler would talk to an E2EEContext: keys to the worker.
+    const keysToWorker = {
+        cleanup: participantId => keyPort.postMessage({
+            operation: 'cleanup',
+            participantId
+        }),
+        cleanupAll: () => keyPort.postMessage({ operation: 'cleanupAll' }),
+        setEnabled: () => undefined,
+        setKey: (participantId, key, keyIndex) => keyPort.postMessage({
+            key,
+            keyIndex,
+            operation: 'setKey',
+            participantId
+        })
+    };
+    const keys = new ManagedKeyHandler(conference, { e2eeCtx: keysToWorker });
+
+    for (const name of FORWARDED_EVENTS) {
+        conference.eventEmitter.on(name, (...args) => send({
+            args,
+            name,
+            type: 'event'
+        }));
+    }
+
+    rpc.onmessage = async ({ data: msg }) => {
+        const participant = id => conference.getParticipantById(id);
+
+        switch (msg?.type) {
+        case 'set-enabled':
+            // What KeyHandler.setEnabled does with keys; the page does the media part.
+            keys.enabled = msg.enabled;
+            conference._e2eeEnabled = msg.enabled;
+            await keys._setEnabled(msg.enabled);
+            send({
+                requestId: msg.requestId,
+                type: 'done'
+            });
+            break;
+        case 'start-verification':
+            participant(msg.id) && keys.sasVerification.startVerification(participant(msg.id));
+            break;
+        case 'mark-verified':
+            participant(msg.id) && keys.sasVerification.markParticipantVerified(participant(msg.id), msg.verified);
+            break;
+        case 'start-group-verification':
+            keys.sasVerification.startGroupVerification();
+            break;
+        case 'report-group-verification':
+            keys.sasVerification.reportGroupVerification(msg.roundId, msg.matches);
+            break;
+        default:
+            msg && conference.onPageMessage(msg);
+        }
+    };
+    send({ type: 'ready' });
+}
+
+window.addEventListener('message', function init(event) {
+    if (event.source !== window.parent || event.data?.type !== 'apespace-e2ee-vault-init' || event.ports.length !== 2) {
+        return;
+    }
+    window.removeEventListener('message', init);
+    if (typeof Olm === 'undefined') {
+        throw new Error('E2EE key vault: Olm is not loaded');
+    }
+    useBuiltInOlmWasm();
+    start(event.ports[0], event.ports[1]);
+});
