index 00000000..7a11743b
--- /dev/null
+++ b/modules/e2ee/VaultKeyHandler.js
@@ -0,0 +1,220 @@
+import { getLogger } from '@jitsi/logger';
+
+import { JitsiConferenceEvents } from '../../JitsiConferenceEvents';
+import { JITSI_MEET_MUC_TYPE } from '../xmpp/constants';
+
+import { KeyHandler } from './KeyHandler';
+
+const logger = getLogger('e2ee:VaultKeyHandler');
+
+/**
+ * The page's side of the E2EE key vault.
+ *
+ * The keys live in the vault: a sandboxed frame (opaque origin, so this page
+ * can't reach into it) that runs the library's open-source key code
+ * (lib-jitsi-meet.e2ee-vault.html). This handler keeps the media part of
+ * {@link KeyHandler} (attaching the encryption transforms, enabling the
+ * worker) and only relays for the vault: the conference's participants and
+ * their E2EE properties, Olm messages (already encrypted) and E2EE events.
+ * The media keys go from the vault straight to the encryption worker, over a
+ * channel whose two ends this page hands over without keeping.
+ */
+export class VaultKeyHandler extends KeyHandler {
+    /**
+     * @param {JitsiConference} conference - The conference.
+     */
+    constructor(conference) {
+        super(conference);
+
+        this._queue = [];
+        this._rpc = undefined;
+        this._requests = new Map();
+        this._nextRequestId = 1;
+        this._createVault();
+
+        const describe = participant => {
+            return {
+                features: [ ...participant._features ?? [] ],
+                hidden: participant.isHidden(),
+                id: participant.getId(),
+                properties: Object.fromEntries([ 'e2ee.enabled', 'e2ee.idKey.curve25519', 'e2ee.idKey.ed25519' ]
+                    .map(name => [ name, participant.getProperty(name) ])
+                    .filter(([ , value ]) => value !== undefined))
+            };
+        };
+
+        conference.on(JitsiConferenceEvents.CONFERENCE_JOINED, () => this._send({
+            myId: conference.myUserId(),
+            participants: conference.getParticipants().map(describe),
+            type: 'conference-joined'
+        }));
+        conference.on(JitsiConferenceEvents.CONFERENCE_LEFT, () => this._send({ type: 'conference-left' }));
+        conference.on(JitsiConferenceEvents.USER_JOINED, (id, participant) => this._send({
+            participant: describe(participant),
+            type: 'participant-joined'
+        }));
+        conference.on(JitsiConferenceEvents.USER_LEFT, id => this._send({
+            id,
+            type: 'participant-left'
+        }));
+        conference.on(JitsiConferenceEvents.PARTCIPANT_FEATURES_CHANGED, participant => this._send({
+            features: [ ...participant._features ?? [] ],
+            id: participant.getId(),
+            type: 'participant-features'
+        }));
+        conference.on(JitsiConferenceEvents.PARTICIPANT_PROPERTY_CHANGED, (participant, name, oldValue, newValue) => {
+            name.startsWith('e2ee.') && this._send({
+                id: participant.getId(),
+                name,
+                newValue,
+                oldValue,
+                type: 'property-changed'
+            });
+        });
+        conference.on(JitsiConferenceEvents.ENDPOINT_MESSAGE_RECEIVED, (participant, payload) => {
+            payload?.[JITSI_MEET_MUC_TYPE] === 'olm' && this._send({
+                from: participant.getId(),
+                payload,
+                type: 'endpoint-message'
+            });
+        });
+    }
+
+    /**
+     * Emoji verification and the group safety number, run in the vault.
+     *
+     * @returns {Object}
+     */
+    get sasVerification() {
+        return {
+            markParticipantVerified: (participant, verified) => this._send({
+                id: participant.getId(),
+                type: 'mark-verified',
+                verified
+            }),
+            reportGroupVerification: (roundId, matches) => this._send({
+                matches,
+                roundId,
+                type: 'report-group-verification'
+            }),
+            startGroupVerification: () => this._send({ type: 'start-group-verification' }),
+            startVerification: participant => this._send({
+                id: participant.getId(),
+                type: 'start-verification'
+            })
+        };
+    }
+
+    /**
+     * Sets up or tears down the keys, in the vault.
+     *
+     * @param {boolean} enabled - Whether E2EE is enabled.
+     * @returns {Promise<void>}
+     */
+    _setEnabled(enabled) {
+        const requestId = this._nextRequestId++;
+
+        return new Promise(resolve => {
+            this._requests.set(requestId, resolve);
+            this._send({
+                enabled,
+                requestId,
+                type: 'set-enabled'
+            });
+        });
+    }
+
+    /**
+     * Creates the vault frame and, once it has loaded, hands it its ports.
+     *
+     * @returns {void}
+     */
+    _createVault() {
+        const iframe = document.createElement('iframe');
+
+        // Scripts only: no same-origin access either way, no navigation of this page, no forms or popups.
+        iframe.setAttribute('sandbox', 'allow-scripts');
+        iframe.setAttribute('aria-hidden', 'true');
+        iframe.setAttribute('tabindex', '-1');
+        iframe.title = 'E2EE key vault';
+        iframe.style.display = 'none';
+        iframe.src = `${baseUrl()}lib-jitsi-meet.e2ee-vault.html`;
+        iframe.addEventListener('load', () => {
+            const rpc = new MessageChannel();
+            const keys = new MessageChannel();
+
+            // The worker's end goes to the worker, the vault's end to the vault: this page keeps neither.
+            this.e2eeCtx.attachKeyPort(keys.port1);
+            rpc.port1.onmessage = ({ data }) => this._onVaultMessage(data);
+            iframe.contentWindow.postMessage({ type: 'apespace-e2ee-vault-init' }, '*', [ rpc.port2, keys.port2 ]);
+            this._rpcPending = rpc.port1;
+        }, { once: true });
+        (document.body ?? document.documentElement).appendChild(iframe);
+        this._iframe = iframe;
+    }
+
+    /**
+     * Sends a message to the vault, or queues it until the vault is ready.
+     *
+     * @param {Object} msg - The message.
+     * @returns {void}
+     */
+    _send(msg) {
+        this._rpc ? this._rpc.postMessage(msg) : this._queue.push(msg);
+    }
+
+    /**
+     * Handles a message from the vault. Only Olm messages, our E2EE presence
+     * properties and E2EE events get through.
+     *
+     * @param {Object} msg - The message.
+     * @returns {void}
+     */
+    _onVaultMessage(msg) {
+        switch (msg?.type) {
+        case 'ready':
+            this._rpc = this._rpcPending;
+            for (const queued of this._queue.splice(0)) {
+                this._rpc.postMessage(queued);
+            }
+            break;
+        case 'send':
+            if (msg.payload?.[JITSI_MEET_MUC_TYPE] === 'olm' && typeof msg.to === 'string') {
+                this.conference.sendMessage(msg.payload, msg.to);
+            }
+            break;
+        case 'set-property':
+            if (/^e2ee\.idKey\.(ed25519|curve25519)$/.test(msg.name)) {
+                this.conference.setLocalParticipantProperty(msg.name, msg.value);
+            }
+            break;
+        case 'event':
+            if (typeof msg.name === 'string' && msg.name.startsWith('conference.e2ee.')) {
+                this.conference.eventEmitter.emit(msg.name, ...msg.args ?? []);
+            }
+            break;
+        case 'done':
+            this._requests.get(msg.requestId)?.();
+            this._requests.delete(msg.requestId);
+            break;
+        default:
+            logger.warn('Unexpected message from the E2EE key vault');
+        }
+    }
+}
+
+/**
+ * The URL this library was loaded from, without the file name: the vault is
+ * served next to it.
+ *
+ * @returns {string}
+ */
+function baseUrl() {
+    const script = document.querySelector('script[src*="lib-jitsi-meet"]');
+
+    if (script?.src) {
+        return script.src.substring(0, script.src.lastIndexOf('/') + 1);
+    }
+
+    return new URL('libs/', document.baseURI).href;
+}
