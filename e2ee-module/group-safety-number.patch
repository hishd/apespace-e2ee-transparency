+import { getLogger } from '@jitsi/logger';
+import base64js from 'base64-js';
+import { v4 as uuidv4 } from 'uuid';
+
+const logger = getLogger('e2ee:GroupVerification');
+
+/**
+ * Message types of the group verification, sent over the same per-participant
+ * signalling as the Olm messages.
+ */
+export const GROUP_MESSAGE_TYPES = {
+    COMMIT: 'group-sas-commit',
+    MISMATCH: 'group-sas-mismatch',
+    REVEAL: 'group-sas-reveal'
+};
+
+/**
+ * Events emitted through the Olm adapter.
+ */
+export const GroupVerificationEvents = {
+    GROUP_VERIFICATION_FAILED: 'olm.group_verification_failed',
+    GROUP_VERIFICATION_OUTDATED: 'olm.group_verification_outdated',
+    GROUP_VERIFICATION_READY: 'olm.group_verification_ready',
+    GROUP_VERIFICATION_REPORTED: 'olm.group_verification_reported'
+};
+
+const TIMEOUT_MS = 30 * 1000;
+const NONCE_BYTES = 32;
+const CODE_DIGITS = 12;
+const COMMIT_CONTEXT = 'apespace-group-sas-commit-v1';
+const CODE_CONTEXT = 'apespace-group-sas-v1';
+
+/**
+ * SHA-256 of a string, as bytes.
+ *
+ * @param {string} text - The input.
+ * @returns {Promise<Uint8Array>}
+ */
+async function sha256(text) {
+    return new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text)));
+}
+
+/**
+ * Commitment to one participant's identity keys and random value for a round.
+ *
+ * @param {string} roundId - The round.
+ * @param {string} participantId - Whose values these are.
+ * @param {Object} entry - { ed25519, curve25519, nonce }.
+ * @returns {Promise<string>} Base64.
+ */
+async function commitment(roundId, participantId, { ed25519, curve25519, nonce }) {
+    return base64js.fromByteArray(
+        await sha256([ COMMIT_CONTEXT, roundId, participantId, `${ed25519}|${curve25519}|${nonce}` ].join('\n')));
+}
+
+/**
+ * The group safety number: 12 digits derived from every participant's identity
+ * keys and random value, the same for everyone only if everyone saw the same
+ * keys.
+ *
+ * @param {string} roundId - The round.
+ * @param {Array<Object>} entries - { ed25519, curve25519, nonce } of every participant, ours included.
+ * @returns {Promise<string>} Digits in groups of four.
+ */
+async function safetyNumber(roundId, entries) {
+    const lines = entries.map(e => `${e.ed25519}|${e.curve25519}|${e.nonce}`).sort();
+    const digest = await sha256([ CODE_CONTEXT, roundId, ...lines ].join('\n'));
+    let value = 0;
+
+    // The first 40 bits, as a number (exact: below 2^53).
+    for (const byte of digest.slice(0, 5)) {
+        value = (value * 256) + byte;
+    }
+    const digits = (value % (10 ** CODE_DIGITS)).toString().padStart(CODE_DIGITS, '0');
+
+    return digits.match(/.{4}/g).join(' ');
+}
+
+/**
+ * One safety number for the whole meeting, compared aloud once instead of
+ * pairwise emoji.
+ *
+ * Every participant draws a random value and first sends only a commitment to
+ * it, bound to its identity keys. It reveals the value once it holds every
+ * other participant's commitment. The safety number is then derived from all
+ * participants' identity keys and values. A server that showed participants
+ * different keys must fix the keys and values it substitutes before it learns
+ * the real values, so it can't make the numbers match (the chance is 1 in
+ * 10^12). An extra participant shown to only some participants changes their
+ * number too.
+ *
+ * The participants of a round are the ones we share our media key with (we
+ * have an Olm session with them), so their Curve25519 keys are authenticated.
+ * Any change to them during a round ends it; after a round, it makes the
+ * number outdated.
+ */
+export default class GroupVerification {
+    /**
+     * @param {OlmAdapter} adapter - Our Olm adapter: identity keys, sessions, signalling.
+     */
+    constructor(adapter) {
+        this._adapter = adapter;
+        this._round = undefined;
+    }
+
+    /**
+     * Starts a round with everyone we share our media key with.
+     *
+     * @returns {Promise<void>}
+     */
+    async start() {
+        await this._begin(uuidv4());
+    }
+
+    /**
+     * Tells the other participants of a round that the number we were shown
+     * didn't match.
+     *
+     * @param {string} roundId - The round.
+     * @returns {void}
+     */
+    reportMismatch(roundId) {
+        const round = this._round;
+
+        if (round?.id !== roundId) {
+            return;
+        }
+        for (const pId of round.members) {
+            this._send(pId, GROUP_MESSAGE_TYPES.MISMATCH, { roundId });
+        }
+    }
+
+    /**
+     * Called when the participants we share our media key with change.
+     *
+     * @returns {void}
+     */
+    onKeyRecipientsChanged() {
+        const round = this._round;
+
+        if (!round) {
+            return;
+        }
+        const now = this._adapter.getKeyRecipients();
+        const same = now.length === round.members.size && now.every(id => round.members.has(id));
+
+        if (same) {
+            return;
+        }
+        if (round.done) {
+            if (!round.outdated) {
+                round.outdated = true;
+                this._emit(GroupVerificationEvents.GROUP_VERIFICATION_OUTDATED, round.id);
+            }
+        } else {
+            this._fail(round, 'participants-changed', []);
+        }
+    }
+
+    /**
+     * Handles a group verification message.
+     *
+     * @param {JitsiParticipant} participant - The sender.
+     * @param {Object} msg - The message: { type, data }.
+     * @returns {Promise<void>}
+     */
+    async onMessage(participant, msg) {
+        const pId = participant.getId();
+        const { roundId } = msg.data ?? {};
+
+        if (typeof roundId !== 'string') {
+            return;
+        }
+
+        switch (msg.type) {
+        case GROUP_MESSAGE_TYPES.COMMIT: {
+            // A commitment for a round we don't run yet starts it, unless we run an
+            // unfinished one that wins (two participants started at the same time:
+            // everyone keeps the smaller round id).
+            const current = this._round;
+
+            if (current?.id !== roundId) {
+                if (current && !current.done && current.id < roundId) {
+                    return;
+                }
+                if (current && !current.done) {
+                    this._abort(current);
+                }
+                await this._begin(roundId);
+            }
+            const round = this._round;
+
+            if (round?.id !== roundId || !round.members.has(pId) || round.commits.has(pId)) {
+                return;
+            }
+            round.commits.set(pId, msg.data.commitment);
+            this._revealIfReady(round);
+            break;
+        }
+        case GROUP_MESSAGE_TYPES.REVEAL: {
+            const round = this._round;
+
+            if (round?.id !== roundId || !round.commits.has(pId) || round.reveals.has(pId) || round.done) {
+                return;
+            }
+            const entry = {
+                ...this._keysOf(participant),
+                nonce: msg.data.nonce
+            };
+
+            if (await commitment(roundId, pId, entry) !== round.commits.get(pId)) {
+                logger.warn(`Group verification: the values ${pId} revealed don't match their commitment`);
+                this._fail(round, 'commitment-mismatch', [ pId ]);
+
+                return;
+            }
+            round.reveals.set(pId, entry);
+            await this._finishIfReady(round);
+            break;
+        }
+        case GROUP_MESSAGE_TYPES.MISMATCH: {
+            const round = this._round;
+
+            if (round?.id === roundId && round.members.has(pId)) {
+                this._emit(GroupVerificationEvents.GROUP_VERIFICATION_REPORTED, roundId, pId, false);
+            }
+            break;
+        }
+        }
+    }
+
+    /**
+     * Starts taking part in a round.
+     *
+     * @param {string} roundId - The round.
+     * @returns {Promise<void>}
+     * @private
+     */
+    async _begin(roundId) {
+        const members = new Set(this._adapter.getKeyRecipients());
+        const nonceBytes = new Uint8Array(NONCE_BYTES);
+
+        crypto.getRandomValues(nonceBytes);
+        const own = {
+            ...this._adapter.getOwnIdentityKeys(),
+            nonce: base64js.fromByteArray(nonceBytes)
+        };
+        const round = {
+            commits: new Map(),
+            done: false,
+            id: roundId,
+            members,
+            outdated: false,
+            own,
+            revealed: false,
+            reveals: new Map(),
+            timer: undefined
+        };
+
+        if (this._round && !this._round.done) {
+            this._abort(this._round);
+        }
+        this._round = round;
+
+        if (!members.size) {
+            this._fail(round, 'no-participants', []);
+
+            return;
+        }
+        round.timer = setTimeout(() => this._fail(round, 'timeout',
+            [ ...members ].filter(id => !round.commits.has(id) || !round.reveals.has(id))), TIMEOUT_MS);
+
+        const ownCommitment = await commitment(roundId, this._adapter.myId, own);
+
+        if (this._round !== round) {
+            return;
+        }
+        for (const pId of members) {
+            this._send(pId, GROUP_MESSAGE_TYPES.COMMIT, {
+                commitment: ownCommitment,
+                roundId
+            });
+        }
+        logger.info(`Group verification round ${roundId} with ${members.size} participant(s)`);
+    }
+
+    /**
+     * Reveals our value once we hold every member's commitment, never before.
+     *
+     * @param {Object} round - The round.
+     * @returns {void}
+     * @private
+     */
+    _revealIfReady(round) {
+        if (round.revealed || round.done || round.commits.size < round.members.size) {
+            return;
+        }
+        round.revealed = true;
+        for (const pId of round.members) {
+            this._send(pId, GROUP_MESSAGE_TYPES.REVEAL, {
+                nonce: round.own.nonce,
+                roundId: round.id
+            });
+        }
+    }
+
+    /**
+     * Derives the safety number once every member's value is revealed.
+     *
+     * @param {Object} round - The round.
+     * @returns {Promise<void>}
+     * @private
+     */
+    async _finishIfReady(round) {
+        if (!round.revealed || round.done || round.reveals.size < round.members.size) {
+            return;
+        }
+        round.done = true;
+        clearTimeout(round.timer);
+        const code = await safetyNumber(round.id, [ round.own, ...round.reveals.values() ]);
+
+        this._emit(GroupVerificationEvents.GROUP_VERIFICATION_READY, round.id, code, [ ...round.members ]);
+    }
+
+    /**
+     * Ends a round without a number.
+     *
+     * @param {Object} round - The round.
+     * @param {string} reason - Why: timeout, participants-changed, commitment-mismatch, no-participants.
+     * @param {Array<string>} participantIds - The participants concerned.
+     * @returns {void}
+     * @private
+     */
+    _fail(round, reason, participantIds) {
+        if (round.done || this._round !== round) {
+            return;
+        }
+        round.done = true;
+        clearTimeout(round.timer);
+        this._emit(GroupVerificationEvents.GROUP_VERIFICATION_FAILED, round.id, reason, participantIds);
+    }
+
+    /**
+     * Drops an unfinished round silently (another round replaces it).
+     *
+     * @param {Object} round - The round.
+     * @returns {void}
+     * @private
+     */
+    _abort(round) {
+        round.done = true;
+        clearTimeout(round.timer);
+    }
+
+    /**
+     * The identity keys we hold for a participant: Ed25519 as published, and the
+     * Curve25519 key authenticated when our Olm session was set up.
+     *
+     * @param {JitsiParticipant} participant - The participant.
+     * @returns {Object} { ed25519, curve25519 }.
+     * @private
+     */
+    _keysOf(participant) {
+        return this._adapter.getParticipantIdentityKeys(participant);
+    }
+
+    /**
+     * @private
+     */
+    _send(pId, type, data) {
+        this._adapter.sendGroupMessage(pId, type, data);
+    }
+
+    /**
+     * @private
+     */
+    _emit(event, ...args) {
+        this._adapter.eventEmitter.emit(event, ...args);
+    }
+}
