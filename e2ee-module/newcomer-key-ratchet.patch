+    }
+
+    /**
+     * Encrypts our current key information for a participant. The first time our
+     * current key goes to a participant, the key first moves one step forward, so
+     * a newcomer never receives the key that encrypted media sent before they
+     * joined; they can only follow it forward from here. (The ratchet on join runs
+     * 5 s after a participant joins, by which time the newcomer would already hold
+     * the earlier key.)
+     *
+     * @param {Object} olmData - The participant's Olm data.
+     * @param {Olm.Session} session - The participant's session.
+     * @returns {Promise<string>} - The encrypted key information.
+     * @private
+     */
+    async _keyInfoFor(olmData, session) {
+        if (this._mediaKey instanceof Uint8Array) {
+            if (!olmData.hasOurKey && this._ratchetForNewRecipient) {
+                await this._ratchetForNewRecipient();
+            }
+            olmData.hasOurKey = true;
+        }
+
+        return this._encryptKeyInfo(session);
+    }
